# InputTest_MiSTer-style player-debug baseline.
#
# The active hardware build instantiates mister_vgm_md_top for debug/status
# only. AUDIO_L/R remain tied to zero in rtl/emu.sv until the video/player
# state path is confirmed on hardware.

set_global_assignment -name SYSTEMVERILOG_FILE rtl/emu.sv
set_global_assignment -name QIP_FILE sys/sys.qip
set_global_assignment -name SYSTEMVERILOG_FILE rtl/megavgm_video_timing.sv

set_global_assignment -name SYSTEMVERILOG_FILE rtl/mister_vgm_md_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/vgm_region_player.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/vgm_file_loader.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/vgm_bram_read_adapter.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/vgm_ddram_backend.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/vgm_c0_lab_backend.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/vgm_loaded_player.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/md_sound_module.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mode5_ym2203_audio_mixer.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ym2203_dynamic_cen.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ym2203_sound_module.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ym2151_sound_module.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/segapcm_sound_module.sv
set_global_assignment -name VERILOG_FILE third_party/jtcores/cores/outrun/hdl/jtoutrun_pcm.v
set_global_assignment -name VERILOG_FILE third_party/jtcores/modules/jtframe/hdl/ram/jtframe_dual_ram.v
# Static SegaPCM preload/sample ROM is intentionally disabled by default.
# For old bring-up only, define SEGA_PCM_EMBED_ROM and add these manually:
# set_global_assignment -name SYSTEMVERILOG_FILE rtl/segapcm_preload_rom.sv
# set_global_assignment -name MISC_FILE rtl/segapcm_lastwave_seashore_payload.mem
set_global_assignment -name QIP_FILE third_party/jt51/hdl/jt51.qip
set_global_assignment -name VERILOG_FILE third_party/jt51/ver/common/sep32.v
set_global_assignment -name VERILOG_FILE third_party/jt51/ver/common/sep32_cnt.v

set_global_assignment -name VERILOG_FILE rtl/genesis_audio/filters/audio_iir_filter.v
