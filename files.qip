# InputTest_MiSTer-style video-only baseline.
#
# The active hardware build intentionally excludes MD sound RTL until the
# proven InputTest-style outer shell passes on real MiSTer hardware.

set_global_assignment -name SYSTEMVERILOG_FILE rtl/emu.sv
set_global_assignment -name QIP_FILE sys/sys.qip
set_global_assignment -name VERILOG_FILE rtl/JTFRAME/jtframe_cen24.v
