# Video-only baseline.
#
# Keep the active MiSTer build as small as possible until the Template_MiSTer
# outer shell is proven on hardware. Sound RTL remains in the repository and is
# still covered by its direct simulation testbenches, but is intentionally not
# part of this first hardware baseline.

set_global_assignment -name SDC_FILE VGM_MD_MiSTer.sdc
set_global_assignment -name SYSTEMVERILOG_FILE rtl/emu.sv
